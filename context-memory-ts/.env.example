# ─── ContextMemory TypeScript — Environment Variables ───────────────────────
#
# Copy this file to .env and fill in your values.
# Run: cp .env.example .env
#
# ─── Option A: OpenRouter (recommended — supports many models) ───────────────
OPENROUTER_API_KEY=sk-or-your-key-here
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ─── Option B: OpenAI directly ───────────────────────────────────────────────
# OPENAI_API_KEY=sk-your-key-here
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# ─── Database (optional) ─────────────────────────────────────────────────────
# Defaults to ~/.contextmemory/memory.db (SQLite, created automatically)
# DATABASE_URL=/custom/path/to/memory.db

# ─── Debug mode ──────────────────────────────────────────────────────────────
# DEBUG=true
